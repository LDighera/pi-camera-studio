#!/bin/sh
set -eu

unset CDPATH
PROJECT_ROOT=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "$PROJECT_ROOT"

temporary=$(mktemp -d "${TMPDIR:-/tmp}/pi-camera-studio-release.XXXXXX")
trap 'rm -rf -- "$temporary"' EXIT HUP INT TERM

fail() {
    printf '%s\n' "release-check: $*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || fail "required command is unavailable: $1"
}

require_command desktop-file-validate
require_command find
require_command grep
require_command mktemp
require_command python3
require_command sed
require_command shellcheck
require_command tar

private_user='lar''ry'
private_root='/ro''ot/'
private_pattern="${private_user}|${private_root}"

if command -v rg >/dev/null 2>&1; then
    if rg -n -i --hidden \
        --glob '!.git' \
        --glob '!.git/**' \
        --glob '!build/**' \
        --glob '!dist/**' \
        --glob '!*.egg-info/**' \
        "$private_pattern" . >"$temporary/private-strings"; then
        sed -n '1,80p' "$temporary/private-strings" >&2
        fail "private user or development paths remain in the release tree"
    else
        status=$?
        [ "$status" -eq 1 ] || fail "private-string scan failed with status $status"
    fi
else
    if grep -R -I -n -i -E \
        --exclude-dir=.git \
        --exclude=.git \
        --exclude-dir=build \
        --exclude-dir=dist \
        --exclude='*.pyc' \
        "$private_pattern" . >"$temporary/private-strings"; then
        sed -n '1,80p' "$temporary/private-strings" >&2
        fail "private user or development paths remain in the release tree"
    else
        status=$?
        [ "$status" -eq 1 ] || fail "private-string scan failed with status $status"
    fi
fi

cache_path=$(find . \
    \( -path './.git' -o -path './build' -o -path './dist' \) -prune -o \
    \( -type d -name __pycache__ -o -type f \( -name '*.pyc' -o -name '*.pyo' \) \) \
    -print -quit)
if [ -n "$cache_path" ]; then
    fail "Python bytecode or cache directories remain in the release tree"
fi

PYTHONPYCACHEPREFIX="$temporary/pycache" python3 - <<'PY'
import re
from importlib.metadata import PackageNotFoundError, version
from pathlib import Path

import pi_camera_studio

package_version = "0.1.0a1"
release_tag = "v0.1.0-alpha.1"
if pi_camera_studio.__version__ != package_version:
    raise SystemExit(
        f"package version is {pi_camera_studio.__version__!r}, expected {package_version!r}"
    )

changelog = Path("CHANGELOG.md").read_text(encoding="utf-8")
if f"## [{release_tag.removeprefix('v')}]" not in changelog:
    raise SystemExit(f"CHANGELOG.md has no section for {release_tag}")

try:
    setuptools_version = version("setuptools")
except PackageNotFoundError:
    raise SystemExit("setuptools is unavailable; version 77 or newer is required") from None
major_match = re.match(r"^(\d+)", setuptools_version)
if major_match is None or int(major_match.group(1)) < 77:
    raise SystemExit(
        f"setuptools {setuptools_version} is too old; version 77 or newer is required "
        "for this non-isolated release build"
    )
PY

python3 - <<'PY'
import hashlib
import json
from pathlib import Path

root = Path("pi_camera_studio/models")
manifest_path = root / "model.json"
if not manifest_path.is_file():
    raise SystemExit(f"model manifest is missing: {manifest_path}")
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))

for filename_key, size_key, digest_key in (
    ("filename", "bytes", "sha256"),
    ("license_file", "license_bytes", "license_sha256"),
):
    path = root / manifest[filename_key]
    if not path.is_file():
        raise SystemExit(f"required model asset is missing: {path}")
    data = path.read_bytes()
    if len(data) != manifest[size_key]:
        raise SystemExit(f"size mismatch for {path}")
    if hashlib.sha256(data).hexdigest() != manifest[digest_key]:
        raise SystemExit(f"SHA-256 mismatch for {path}")
PY

PYTHONPYCACHEPREFIX="$temporary/pycache" \
    python3 -m compileall -q pi_camera_studio tests

detector_log="$temporary/detector.log"
if ! PYTHONPYCACHEPREFIX="$temporary/pycache" \
    python3 -m unittest -v \
    tests.test_detector.DetectorGeometryTests.test_pinned_model_loads_and_infers \
    >"$detector_log" 2>&1; then
    sed -n '1,120p' "$detector_log" >&2
    fail "mandatory bundled-model inference test failed"
fi
sed -n '1,120p' "$detector_log"
if grep -Eiq 'skipped|skip=' "$detector_log"; then
    fail "mandatory bundled-model inference test was skipped"
fi

test_log="$temporary/unittest.log"
if ! PYTHONPYCACHEPREFIX="$temporary/pycache" \
    python3 -m unittest discover -v >"$test_log" 2>&1; then
    sed -n '1,240p' "$test_log" >&2
    fail "unit tests failed"
fi
sed -n '1,240p' "$test_log"
if grep -Eiq 'skipped|skip=' "$test_log"; then
    fail "a test was skipped; detector/model coverage is mandatory"
fi

shellcheck \
    bin/pi-camera-studio \
    deploy/pi-camera-studio \
    install.sh \
    scripts/release-check \
    uninstall.sh
desktop-file-validate deploy/pi-camera-studio.desktop

mkdir "$temporary/source"
source_archive="$temporary/source.tar"
tar \
    --exclude='./.git' \
    --exclude='./build' \
    --exclude='./dist' \
    --exclude='./*.egg-info' \
    -cf "$source_archive" .
tar -xf "$source_archive" -C "$temporary/source"

(
    cd "$temporary/source"
    if python3 -c 'import build' >/dev/null 2>&1; then
        PYTHONPYCACHEPREFIX="$temporary/build-pycache" \
            python3 -m build --no-isolation --outdir "$temporary/dist"
    else
        mkdir "$temporary/dist"
        PYTHONPYCACHEPREFIX="$temporary/build-pycache" \
            python3 - "$temporary/dist" <<'PY'
import sys
from setuptools.build_meta import build_sdist, build_wheel

output_directory = sys.argv[1]
build_wheel(output_directory)
build_sdist(output_directory)
PY
    fi
)

python3 - "$temporary/dist" <<'PY'
import sys
import tarfile
import zipfile
from pathlib import Path

distribution_directory = Path(sys.argv[1])
wheels = list(distribution_directory.glob("*.whl"))
sdists = list(distribution_directory.glob("*.tar.gz"))
if len(wheels) != 1 or len(sdists) != 1:
    raise SystemExit("expected exactly one wheel and one source distribution")

wheel_suffixes = (
    "pi_camera_studio/models/LICENSE.NanoDet",
    "pi_camera_studio/models/README.md",
    "pi_camera_studio/models/model.json",
    "pi_camera_studio/models/object_detection_nanodet_2022nov.onnx",
    ".dist-info/licenses/LICENSE",
    ".dist-info/licenses/NOTICE",
    ".dist-info/licenses/pi_camera_studio/models/LICENSE.NanoDet",
    ".dist-info/entry_points.txt",
    ".dist-info/METADATA",
)
with zipfile.ZipFile(wheels[0]) as archive:
    names = archive.namelist()
    missing = [
        suffix for suffix in wheel_suffixes
        if not any(name.endswith(suffix) for name in names)
    ]
    if missing:
        raise SystemExit(f"wheel is missing required assets: {missing}")

sdist_suffixes = (
    "/LICENSE",
    "/NOTICE",
    "/README.md",
    "/CHANGELOG.md",
    "/CONTRIBUTING.md",
    "/RELEASING.md",
    "/SECURITY.md",
    "/VERIFICATION.md",
    "/install.sh",
    "/uninstall.sh",
    "/deploy/pi-camera-studio.desktop",
    "/scripts/release-check",
    "/tests/test_detector.py",
    "/pi_camera_studio/models/LICENSE.NanoDet",
    "/pi_camera_studio/models/README.md",
    "/pi_camera_studio/models/model.json",
    "/pi_camera_studio/models/object_detection_nanodet_2022nov.onnx",
)
with tarfile.open(sdists[0], "r:gz") as archive:
    names = archive.getnames()
    missing = [
        suffix for suffix in sdist_suffixes
        if not any(name.endswith(suffix) for name in names)
    ]
    if missing:
        raise SystemExit(f"source distribution is missing required assets: {missing}")
PY

printf '%s\n' "release-check: all non-hardware checks passed"
